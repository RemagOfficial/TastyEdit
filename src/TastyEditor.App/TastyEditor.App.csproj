<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The product is TastyEdit (S-D10 rename). Only the executable and its file properties carry
         that name: the project folder, RootNamespace and the solution keep their identifiers, so the
         documented headless gate commands (dotnet run against this project) still work. -->
    <AssemblyName>TastyEdit</AssemblyName>
    <RootNamespace>TastyEditor.App</RootNamespace>
    <Product>TastyEdit</Product>
    <AssemblyTitle>TastyEdit</AssemblyTitle>
    <!-- The title bar shows this string (MainWindow.BaseTitle), so a bug report names the build.
         Release checklist (docs/DEVELOPMENT.md): bump it and write the CHANGELOG entry, and commit
         both before publishing - the SDK stamps the commit into the assembly's informational
         version while it builds. -->
    <Version>1.0.1</Version>
    <!-- Explorer / taskbar icon. Regenerate from assets/app-icon.png with tools/make_icon.py; the
         same file is carried as a WPF resource below so the window title bar uses it too. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- The five family tiles, generated by tools/make_icon.py in its games mode. They ship next
         to the executable for two reasons: the window can then show which game the open level
         belongs to, and the installer's Start-Menu shortcuts can point at a real .ico file -
         Explorer reads a shortcut's icon from disk, it will not look inside the apphost. -->
    <Content Include="icons\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TastyEditor.Core\TastyEditor.Core.csproj" />
  </ItemGroup>

</Project>
